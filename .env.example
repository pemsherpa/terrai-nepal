# Frontend (optional — Vite proxies /api to Django in dev)
# VITE_API_URL=

# Django backend database: 'sqlite' or 'postgresql'
DB_ENGINE=postgresql
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true

# Satellite analysis + AI reports (also loaded from forest_health_app/.env if present)
GEE_PROJECT_ID=
GROQ_API_KEY=
# Strong default: openai/gpt-oss-120b (llama3-70b-8192 is decommissioned)
GROQ_MODEL=openai/gpt-oss-120b

# Async jobs + shared cache (optional — without Redis, DB cache + thread worker is used)
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_TASK_ALWAYS_EAGER=false
